{
  "profile": "full",
  "baseBranch": "main",
  "delegation": {
    "verify-init": "self",
    "verify-run": "subagent",
    "diff-gate": "subagent",
    "isolated-review": "subagent",
    "verify-retro": "subagent"
  },
  "commitCheck": {
    "mode": "observe",
    "requireAny": ["verify-run", "isolated-review"],
    "maxAgeMinutes": 120,
    "maxBlocksPerSession": 2
  }
}
